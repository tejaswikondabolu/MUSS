{% extends "base.html.tera" %}

{% block title %}Exhibit Not Found — Hogwarts School of Witchcraft & Programming{% endblock title %}

{% block content %}
<div class="page-header">
    <pre class="ascii-art">
╔═══════════════════════════════════════╗
║                                       ║
║   EXHIBIT NOT FOUND                   ║
║                                       ║
╚═══════════════════════════════════════╝
    </pre>
    <p>The house "{{ religion_id }}" does not exist in our school.</p>
    <p>Perhaps this magical language is taught at a different wizarding institution.</p>
    <a href="/" class="cta-button">Return to the Great Hall</a>
</div>
{% endblock content %}
