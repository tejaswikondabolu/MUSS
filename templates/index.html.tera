{% extends "base.html.tera" %}

{% block title %}Hogwarts School of Witchcraft & Programming — Home{% endblock title %}

{% block content %}
<div class="hero">
    <pre class="ascii-art">

╔═══════════════════════════════════════════╗
║                                           ║
║   ██╗  ██╗ ██████╗  ██████╗ ██╗    ██╗   ║
║   ██║  ██║██╔═══██╗██╔═══██╗██║    ██║   ║
║   ███████║██║   ██║██║   ██║██║ █╗ ██║   ║
║   ██╔══██║██║   ██║██║   ██║██║███╗██║   ║
║   ██║  ██║╚██████╔╝╚██████╔╝╚███╔███╔╝   ║
║   ╚═╝  ╚═╝ ╚═════╝  ╚═════╝  ╚══╝╚══╝    ║
║                                           ║
║   HOGWARTS SCHOOL OF WITCHCRAFT           ║
║   & PROGRAMMING                           ║
║                                           ║
╚═══════════════════════════════════════════╝
    </pre>
    <p class="hero-subtitle">Where programming languages become houses,<br>compiler errors become forbidden spells, and code tells magical stories.</p>
    <div class="hero-cta">
        <a href="#rotunda" class="cta-button">Enter the Great Hall →</a>
        <a href="/heresy" class="cta-button cta-secondary">Heresy Chamber</a>
    </div>
</div>

<div class="welcome-text">
    <p>Welcome, young witch or wizard, to Hogwarts School of Witchcraft & Programming.</p>
    <p>Here we study the ancient magical languages of the software civilization. Every programming language is a house. Every feature is a spell. Every compiler error is a misfired incantation.</p>
    <p>Walk through our enchanted corridors. Learn the sacred incantations. Witness the magical artifacts. And if you dare — submit your code to the <a href="/heresy">Heresy Analysis Chamber</a> for judgment by the Sorting Hat.</p>
</div>

<section id="rotunda" class="rotunda-section">
    <div class="rotunda-hall">
        <div class="hall-colonnade">
            <div class="colonnade-shaft left-shaft">
                <div class="shaft-fluting"></div>
                <div class="shaft-fluting"></div>
                <div class="shaft-fluting"></div>
            </div>
            <div class="colonnade-shaft right-shaft">
                <div class="shaft-fluting"></div>
                <div class="shaft-fluting"></div>
                <div class="shaft-fluting"></div>
            </div>
        </div>
        <div class="hall-vault">
            <div class="vault-oculus">
                <div class="oculus-rim"></div>
                <div class="oculus-sky"></div>
                <div class="oculus-ray r1"></div>
                <div class="oculus-ray r2"></div>
                <div class="oculus-ray r3"></div>
                <div class="oculus-ray r4"></div>
                <div class="oculus-ray r5"></div>
                <div class="oculus-ray r6"></div>
                <div class="oculus-ray r7"></div>
                <div class="oculus-ray r8"></div>
            </div>
        </div>
        <div class="hall-sconce left-sconce">✦</div>
        <div class="hall-sconce right-sconce">✦</div>
        <div class="hall-floor">
            <div class="alcoves">
                {% for religion in religions %}
                {% if loop.index0 == 2 %}
                <div class="rotunda-center">
                    <div class="medallion-container">
                        <span class="compass-n">N</span>
                        <span class="compass-s">S</span>
                        <span class="compass-e">E</span>
                        <span class="compass-w">W</span>
                        <div class="medallion-eye"></div>
                    </div>
                    <div class="center-beam"></div>
                    <div class="rotunda-crown">◇</div>
                    <h2 class="rotunda-grand-title">⟨ THE FOUR HOUSES ⟩</h2>
                    <div class="title-divider">
                        <span class="divider-line"></span>
                        <span class="divider-diamond">◆</span>
                        <span class="divider-line"></span>
                    </div>
                    <p class="rotunda-grand-subtitle">Four houses enshrined in the Castle — the Sorting Hat awaits thy choice</p>
                </div>
                {% endif %}
                <div class="alcove" style="--religion-color: {{ religion.color }};">
                    <a href="/exhibit/{{ religion.id }}" class="alcove-link">
                        <div class="alcove-arch">
                            <span class="arch-stone"></span>
                            <span class="arch-stone"></span>
                            <span class="arch-stone"></span>
                            <span class="arch-stone"></span>
                            <span class="arch-stone keystone"></span>
                        </div>
                        <div class="alcove-stained-glass">
                            <div class="stained-glass-lead">
                                <div class="stained-glass-symbol">{{ religion.icon }}</div>
                            </div>
                            <h3 class="alcove-name">{{ religion.name }}</h3>
                        </div>
                        <div class="alcove-frieze">
                            <div class="triglyph"></div>
                            <span class="frieze-text">{{ religion.house }} · {{ religion.subtitle }}</span>
                            <div class="triglyph"></div>
                        </div>
                        <div class="alcove-body-area">
                            <div class="pillar left">
                                <span class="pillar-base"></span>
                                <span class="pillar-shaft"></span>
                                <span class="pillar-capital"></span>
                            </div>
                            <div class="alcove-body">
                                <p class="alcove-belief"><strong>Core Spell:</strong><br>{{ religion.core_belief }}</p>
                                <p class="alcove-deity"><strong>Founder:</strong> {{ religion.deity }}</p>
                                <p class="alcove-founded"><strong>Founded:</strong> {{ religion.founded }}</p>
                                <p class="alcove-danger"><strong>House Color:</strong> <span style="color: {{ religion.house_color }};">⬤</span> {{ religion.house }}</p>
                            </div>
                            <div class="pillar right">
                                <span class="pillar-base"></span>
                                <span class="pillar-shaft"></span>
                                <span class="pillar-capital"></span>
                            </div>
                        </div>
                        <div class="alcove-pedestal">
                            <span class="pedestal-plaque">Visit {{ religion.house }} →</span>
                        </div>
                    </a>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<section class="features-section">
    <h2 class="section-title">═══════════ Hogwarts Corridors ═══════════</h2>
    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">🔍</div>
            <h3>Heresy Detector</h3>
            <p>Submit your code to the Heresy Analysis Chamber. The Sorting Hat will examine it for violations of magical law.</p>
            <a href="/heresy" class="feature-link">Enter the Chamber →</a>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🚶</div>
            <h3>Pilgrimages</h3>
            <p>Embark on guided journeys through the houses. Learn their spells and histories through enchanted exhibits.</p>
            <a href="/pilgrimage" class="feature-link">Begin Journey →</a>
        </div>
        <div class="feature-card">
            <div class="feature-icon">💎</div>
            <h3>Magical Relics</h3>
            <p>View the sacred artifacts of each house. From the Sword of Gryffindor to the Coercion Stone.</p>
            <a href="/relics" class="feature-link">Browse Relics →</a>
        </div>
        <div class="feature-card">
            <div class="feature-icon">⚔️</div>
            <h3>Magical Wars</h3>
            <p>Explore the great conflicts of software wizardry. Gryffindor vs Slytherin. Ravenclaw vs Hufflepuff. And more.</p>
            <a href="/wars" class="feature-link">Study Conflicts →</a>
        </div>
    </div>
</section>
{% endblock content %}
