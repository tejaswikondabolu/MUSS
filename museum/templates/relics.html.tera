{% extends "base.html.tera" %}

{% block title %}Magical Relics — Hogwarts School of Witchcraft & Programming{% endblock title %}

{% block content %}
<div class="page-header">
    <pre class="ascii-art">
╔═══════════════════════════════════════╗
║                                       ║
║   MAGICAL RELICS                      ║
║   THE VAULT OF ENCHANTED ARTIFACTS    ║
║                                       ║
╚═══════════════════════════════════════╝
    </pre>
    <p>Sacred artifacts from across the wizarding programming world. Each relic embodies a core concept of its house's magical philosophy.</p>
</div>

<div class="relics-all-grid">
    {% for relic in relics %}
    <div class="relic-full-card">
        <h3>{{ relic.name }}</h3>
        <p class="relic-religion">From: <a href="/exhibit/{{ relic.religion_id }}">{{ relic.religion_name }}</a></p>
        <p class="relic-desc">{{ relic.description }}</p>
        <p class="relic-power"><strong>Magical Property:</strong> {{ relic.power }}</p>
    </div>
    {% endfor %}
</div>
{% endblock content %}
